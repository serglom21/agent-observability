# Where agent spans are sent. The DSN public key is a secret.
SENTRY_DSN=

# The project the alert is about. The agent reads this telemetry through the Sentry MCP.
SENTRY_ORG=
SENTRY_PROJECT=

# Token for the Sentry MCP server. Not the DSN.
SENTRY_ACCESS_TOKEN=

# Optional. Default is sonnet.
# CLAUDE_MODEL=sonnet

# Default off. Set to 1 to attach the prompt, the final answer, tool arguments,
# and tool results on the gen_ai spans.
# The project data scrubber does not remove file paths or organization slugs.
# DICTATION_FIXER_CAPTURE_CONTENT=1

# Optional. If set, webhook.py requires Sentry-Hook-Signature to be the
# HMAC-SHA256 hex digest of the raw body. If unset, signatures are not checked.
# SENTRY_WEBHOOK_SECRET=
